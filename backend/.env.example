# ===== LLM（OpenAI 兼容接口，示例为 DeepSeek）=====
DEEPQUEST_LLM_API_KEY=sk-xxx
DEEPQUEST_LLM_BASE_URL=https://api.deepseek.com/v1
DEEPQUEST_LLM_MODEL=deepseek-chat

# ===== 搜索工具（Tavily，https://tavily.com 免费注册）=====
TAVILY_API_KEY=tvly-xxx

# ===== 持久化：memory（零依赖）或 postgres（docker compose up -d 启动）=====
DEEPQUEST_PERSISTENCE_TYPE=memory
DEEPQUEST_POSTGRES_URI=postgresql://deepquest:deepquest@localhost:5432/deepquest

# ===== 可观测性（可选，不启用不影响主流程）=====
DEEPQUEST_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://localhost:3000

# ===== MCP 工具（可选，格式见 mcp.json.example；留空禁用）=====
DEEPQUEST_MCP_CONFIG=
